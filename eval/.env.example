# Get your OpenRouter API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override default models per SDK (uncomment to use)
# CLAUDE_MODEL=anthropic/claude-opus-4
# OPENAI_MODEL=openai/gpt-5
# GOOGLE_MODEL=google/gemini-2.5-pro
# MICROSOFT_MODEL=openai/gpt-5

# Self-hosted model (vLLM / LiteLLM gateway behind Cloudflare Access)
# Full chat-completions URL, e.g. https://my-host.example.com/v1/chat/completions
HOSTED_ENDPOINT=
# Cloudflare Access service-token credentials (CF-Access-Client-Id / CF-Access-Client-Secret headers)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Model name as registered in vLLM (shown by GET /v1/models)
# HOSTED_MODEL=Qwen/Qwen3.6-35B-A3B
